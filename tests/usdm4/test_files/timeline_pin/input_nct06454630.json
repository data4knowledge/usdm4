      "conditions": {
        "found": true,
        "items": [
          {
            "reference": "1",
            "text": "Assessments for this visit may be performed in the hospital if the participant has not yet been discharged."
          },
          {
            "reference": "2",
            "text": "If the participant is discharged prior to this visit, then information may be collected by telephone call; vital signs and assessments requiring blood draw may be omitted."
          },
          {
            "reference": "3",
            "text": "To be performed in women 55 years of age or younger."
          },
          {
            "reference": "4",
            "text": "Randomization will occur after completion of surgery on day 1."
          },
          {
            "reference": "5",
            "text": "Dosing will occur after the end of surgery, and at least after removal of the needle/catheter used for spinal/epidural anesthesia."
          },
          {
            "reference": "6",
            "text": "First dose will be given after the end of surgery."
          },
          {
            "reference": "7",
            "text": "May include confirmatory studies for DVT of the leg or PE, as described in Section 8.2.2.2. Confirmatory studies for suspected DVT of the leg or PE may be required more than once, per the discretion of the investigator."
          },
          {
            "reference": "8",
            "text": "Refer to Table 3 for detailed information on visit 2 samples."
          },
          {
            "reference": "9",
            "text": "Samples for ADA must be collected prior to dose administration on the same day that study drug is administrated. Refer to Table 3."
          },
          {
            "reference": "10",
            "text": "The genomics substudy ICF (DNA analysis) must be signed prior to performing this sample collection."
          },
          {
            "reference": "11",
            "text": "Samples for DNA extraction should be collected at the baseline visit (predose) but may also be collected at any later study visit."
          }
        ]
      }
